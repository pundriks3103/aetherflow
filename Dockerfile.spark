FROM apache/spark:3.5.1

USER root

# Delta Lake JVM libraries
RUN curl -fL \
    https://repo.maven.apache.org/maven2/io/delta/delta-spark_2.12/3.2.0/delta-spark_2.12-3.2.0.jar \
    -o /opt/spark/jars/delta-spark_2.12-3.2.0.jar \
 && curl -fL \
    https://repo.maven.apache.org/maven2/io/delta/delta-storage/3.2.0/delta-storage-3.2.0.jar \
    -o /opt/spark/jars/delta-storage-3.2.0.jar

# Kafka connector for Spark 3.5.1 / Scala 2.12
RUN curl -fL \
    https://repo.maven.apache.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.1/spark-sql-kafka-0-10_2.12-3.5.1.jar \
    -o /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.1.jar \
 && curl -fL \
    https://repo.maven.apache.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.1/spark-token-provider-kafka-0-10_2.12-3.5.1.jar \
    -o /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-3.5.1.jar

RUN curl -fL \
    https://repo.maven.apache.org/maven2/org/apache/kafka/kafka-clients/3.4.1/kafka-clients-3.4.1.jar \
    -o /opt/spark/jars/kafka-clients-3.4.1.jar \
 && curl -fL \
    https://repo.maven.apache.org/maven2/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar \
    -o /opt/spark/jars/commons-pool2-2.11.1.jar

# Hadoop S3A and matching AWS SDK bundle
RUN curl -fL \
    https://repo.maven.apache.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar \
    -o /opt/spark/jars/hadoop-aws-3.3.4.jar \
 && curl -fL \
    https://repo.maven.apache.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar \
    -o /opt/spark/jars/aws-java-sdk-bundle-1.12.262.jar

# Python packages for Delta Lake and the live market producer
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir \
    --no-deps delta-spark==3.2.0 \
 && python3 -m pip install --no-cache-dir -r /tmp/requirements.txt

# Pipeline entry points available to both the Spark driver and executors.
COPY scripts/ /opt/aetherflow/scripts/
COPY config/ /opt/aetherflow/config/
COPY aetherflow_delta_smoke_test.py /opt/aetherflow/aetherflow_delta_smoke_test.py

ENV PYTHONPATH="/opt/aetherflow/scripts:/opt/spark/python/lib/pyspark.zip:/opt/spark/python/lib/py4j-0.10.9.7-src.zip"
ENV AETHERFLOW_CONTEXT=compose
ENV AETHERFLOW_CONFIG=/opt/aetherflow/config/aetherflow.yml

USER 0:0
